# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DECISION_API_BASE_URL=https://research-api-henna.vercel.app

# Blockchain (Sepolia) - Optional for now
SEPOLIA_RPC_URL=https://rpc.sepolia.org
PRIVATE_KEY=

# Contract Addresses (fill after deployment)
NEXT_PUBLIC_V2G_TOKEN_ADDRESS=
NEXT_PUBLIC_REWARD_DISTRIBUTOR_ADDRESS=

# Electricity Maps API (for real-time grid data)
# Get your API key from: https://api-portal.electricitymaps.com/
ELECTRICITY_MAPS_API_KEY=
# Zone for India: IN-SO (Southern), IN-NO (Northern), IN-WE (Western), IN-EA (Eastern), IN-NE (North Eastern)
ELECTRICITY_MAPS_ZONE=IN-SO
