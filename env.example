# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Blockchain (Sepolia) - for future implementation
SEPOLIA_RPC_URL=https://rpc.sepolia.org
PRIVATE_KEY=your_wallet_private_key

# Contract Addresses (fill after deployment)
NEXT_PUBLIC_V2G_TOKEN_ADDRESS=
NEXT_PUBLIC_REWARD_DISTRIBUTOR_ADDRESS=

# Grid API (for municipality/authority to set stress levels)
GRID_API_KEY=demo-grid-key

# Price Data Source: mock, dataset, iex_live
PRICE_DATA_SOURCE=mock

# ML Settings
ML_MODEL_ENABLED=true
ML_LEARNING_RATE=0.001
ML_DISCOUNT_FACTOR=0.95
ML_EXPERIENCE_BUFFER_SIZE=10000

# External APIs (optional - will use mock data if not set)
ELECTRICITY_PRICE_API_KEY=
WEATHER_API_KEY=
